{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONPATH=$HOME/.claude/lib/python $HOME/.local/pipx/venvs/nwave-ai/bin/python -m des.adapters.drivers.hooks.claude_code_hook_adapter post-tool-use"
          }
        ],
        "matcher": "Agent"
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONPATH=$HOME/.claude/lib/python $HOME/.local/pipx/venvs/nwave-ai/bin/python -m des.adapters.drivers.hooks.claude_code_hook_adapter subagent-start"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONPATH=$HOME/.claude/lib/python $HOME/.local/pipx/venvs/nwave-ai/bin/python -m des.adapters.drivers.hooks.claude_code_hook_adapter subagent-stop"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONPATH=$HOME/.claude/lib/python $HOME/.local/pipx/venvs/nwave-ai/bin/python -m des.adapters.drivers.hooks.claude_code_hook_adapter deliver-progress"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONPATH=$HOME/.claude/lib/python $HOME/.local/pipx/venvs/nwave-ai/bin/python -m des.adapters.drivers.hooks.claude_code_hook_adapter pre-task"
          }
        ],
        "matcher": "Agent"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "INPUT=$(cat); echo \"$INPUT\" | grep -q 'execution-log\\.json' && { echo \"$INPUT\" | PYTHONPATH=$HOME/.claude/lib/python $HOME/.local/pipx/venvs/nwave-ai/bin/python -m des.adapters.drivers.hooks.claude_code_hook_adapter pre-write; exit $?; }; test -f .nwave/des/deliver-session.json || exit 0; echo \"$INPUT\" | PYTHONPATH=$HOME/.claude/lib/python $HOME/.local/pipx/venvs/nwave-ai/bin/python -m des.adapters.drivers.hooks.claude_code_hook_adapter pre-write"
          }
        ],
        "matcher": "Write"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "INPUT=$(cat); echo \"$INPUT\" | grep -q 'execution-log\\.json' && { echo \"$INPUT\" | PYTHONPATH=$HOME/.claude/lib/python $HOME/.local/pipx/venvs/nwave-ai/bin/python -m des.adapters.drivers.hooks.claude_code_hook_adapter pre-edit; exit $?; }; test -f .nwave/des/deliver-session.json || exit 0; echo \"$INPUT\" | PYTHONPATH=$HOME/.claude/lib/python $HOME/.local/pipx/venvs/nwave-ai/bin/python -m des.adapters.drivers.hooks.claude_code_hook_adapter pre-edit"
          }
        ],
        "matcher": "Edit"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "# des-hook:pre-bash\nINPUT=$(cat); CMD=$(echo \"$INPUT\" | python3 -c \"import sys,json; print(json.load(sys.stdin).get('tool_input',{}).get('command',''))\"); echo \"$CMD\" | grep -q 'execution-log' || exit 0; echo \"$CMD\" | grep -qE 'des\\.cli\\.(log_phase|init_log|verify_deliver_integrity)' && exit 0; echo '{\"decision\":\"block\",\"reason\":\"Direct modification of execution-log.json via Bash is blocked.\\nTo read it, use the Read tool.\\nTo modify it, use des.cli.log_phase.\"}'; exit 2"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONPATH=$HOME/.claude/lib/python $HOME/.local/pipx/venvs/nwave-ai/bin/python -m des.adapters.drivers.hooks.claude_code_hook_adapter session-start"
          }
        ],
        "matcher": "startup"
      }
    ]
  },
  "env": {
    "SLASH_COMMAND_TOOL_CHAR_BUDGET": "100000",
